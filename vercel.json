{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/surveyMailFormSender",
      "destination": "/api/surveyMailFormSender.js"
    },
    {
      "source": "/api/contactMailFormSender",
      "destination": "/api/contactMailFormSender.js"
    },
    {
      "source": "/api/featuresFeedbackFormSender",
      "destination": "/api/featuresFeedbackFormSender.js"
    },
    {
      "source": "/api/sendNewsSectionFeedback",
      "destination": "/api/sendNewsSectionFeedback.js"
    },
    {
      "source": "/api/signUpFeedbackFormSender",
      "destination": "/api/signUpFeedbackFormSender.js"
    },
    {
      "source": "/api/documentationFeedbackFormSender",
      "destination": "/api/documentationFeedbackFormSender.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net cdnjs.cloudflare.com cdn.iubenda.com embeds.iubenda.com codicebusiness.shinystat.com pianiemergenza.protezionecivile.fvg.it kit.fontawesome.com www.paypal.com www.googletagmanager.com www.gstatic.com www.clarity.ms scripts.clarity.ms myfrem.friuliemergenze.it; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdnjs.cloudflare.com client.crisp.chat; font-src 'self' fonts.gstatic.com cdnjs.cloudflare.com client.crisp.chat; img-src 'self' data: https:; connect-src 'self' https: wss: ipapi.co geoip.maxmind.com; frame-src 'self' https://pianiemergenza.protezionecivile.fvg.it; frame-ancestors 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), microphone=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/gallery.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://myfrem.friuliemergenze.it"
        }
      ]
    },
    {
      "source": "/news.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://myfrem.friuliemergenze.it"
        }
      ]
    },
    {
     "source": "/assets/(.*)",
     "headers": [
       {
        "key": "Cache-Control",
        "value": "public, max-age=31536000, immutable"
       },
       {
        "key": "Access-Control-Allow-Origin",
        "value": "*"
       },
       {
        "key": "Access-Control-Allow-Methods",
        "value": "GET"
       }
     ]
   },
   {
     "source": "/(gallery|news).json",
     "headers": [
       {
         "key": "Cache-Control",
         "value": "public, max-age=3600"
       }
     ]
   }
  ],
  "redirects": [
    {
      "source": "/webvisitors",
      "destination": "https://report.shinystat.com/",
      "permanent": true
    }
  ]
}